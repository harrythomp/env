# Initially auto-generated by compose2nix from ./docker-compose.yml

inputs: { pkgs, lib, config, ... }:

let
    cfg = config.env.homeServer.services.navidrome;
    navidromeUser = cfg.user;
    navidromeTag = "0.64.1";
in
{
    options.env.homeServer.services.navidrome = {

        enable = lib.mkEnableOption "navidrome";

        serviceLocation = lib.mkOption {
            type = lib.types.str;
            default = "${config.env.homeServer.servicesLocation}/navidrome";
        };

        backup = lib.mkOption {
            type = lib.types.bool;
            default = config.env.homeServer.backup;
        };

        user = lib.mkOption {
            type = lib.types.str;
            default = "navidrome";
        };

    };

    config = lib.mkIf cfg.enable {

        # Runtime
        virtualisation.podman = {
            enable = true;
            autoPrune.enable = true;
            dockerCompat = true;
        };

        # Enable container name DNS for all Podman networks.
        networking.firewall.interfaces = let
            matchAll = if !config.networking.nftables.enable then "podman+" else "podman*";
        in {
            "${matchAll}".allowedUDPPorts = [ 53 ];
        };

        virtualisation.oci-containers.backend = "podman";

        # User
        users = {
            groups.navidrome = {};
            users.navidrome = {
                isSystemUser = true;
                group = "navidrome";
                description = "Navidrome service runner";
                linger = true;
                home = cfg.serviceLocation;
                autoSubUidGidRange = true;
            };
        };

        # Containers
        virtualisation.oci-containers.containers."navidrome" = {
            image = "deluan/navidrome:${navidromeTag}";
            volumes = [
                "${cfg.serviceLocation}/data:/data:rw"
                "${cfg.serviceLocation}/music:/music:ro"
            ];
            ports = [
                "4533:4533/tcp"
            ];
            log-driver = "journald";
            extraOptions = [
                "--userns=keep-id"
                "--network-alias=navidrome"
                "--network=navidrome_default"
            ];
            podman.user = navidromeUser;
        };
        systemd.services."podman-navidrome" = {
            serviceConfig = {
                Restart = lib.mkOverride 90 "always";
                User = navidromeUser;
            };
            after = [
                "podman-network-navidrome_default.service"
            ];
            requires = [
                "podman-network-navidrome_default.service"
            ];
            partOf = [
                "navidrome-root.target"
            ];
            wantedBy = [
                "navidrome-root.target"
            ];
        };

        # Networks
        systemd.services."podman-network-navidrome_default" = {
            path = [ pkgs.podman "/run/wrappers" ];
            serviceConfig = {
                Type = "oneshot";
                RemainAfterExit = true;
                ExecStop = "podman network rm -f navidrome_default";
                User = navidromeUser;
            };
            script = ''
                podman network inspect navidrome_default || podman network create navidrome_default
                '';
            partOf = [ "navidrome-root.target" ];
            wantedBy = [ "navidrome-root.target" ];
        };

        # Root service
        # When started, this will automatically create all resources and start
        # the containers. When stopped, this will teardown all resources.
        systemd.targets."navidrome-root" = {
            unitConfig = {
                Description = "Root target generated by compose2nix.";
            };
            wantedBy = [ "multi-user.target" ];
        };

    };
}
