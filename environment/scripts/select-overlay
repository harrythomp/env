#!/usr/bin/env bash

SOURCE=${SOURCE:-"$HOME/env"}
OVERLAYS_SOURCE=${OVERLAYS_SOURCE:-"$SOURCE/environment/overlays"}

overlay_names="$(find "$OVERLAYS_SOURCE" -maxdepth 1 -mindepth 1 -type d -exec basename {} \; | sort)"

overlay="$(echo "$overlay_names" | head -c -1 | selector "Select overlay...")"

if [ -z "$overlay" ]; then
    echo "No overlay selected"
    exit 1
fi

OVERLAY="$overlay" dots switch
