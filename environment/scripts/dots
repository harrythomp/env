#!/usr/bin/env bash

SOURCE=${SOURCE:-"$HOME/env"}
TARGET=${TARGET:-"$HOME"}

XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-"$TARGET/.config"}

CONFIG_SOURCE=${CONFIG_SOURCE:-"$SOURCE/environment/config"}
CONFIG_TARGET=${CONFIG_TARGET:-"$XDG_CONFIG_HOME"}

SCRIPTS_SOURCE=${SCRIPTS_SOURCE:-"$SOURCE/environment/scripts"}
SCRIPTS_TARGET=${SCRIPTS_TARGET:-"$TARGET/.local/scripts"}

HOSTS_SOURCE=${HOSTS_SOURCE:-"$SOURCE/environment/hosts"}

if [ -z "$HOST" ] && command -v hostname &> /dev/null; then
    HOST=$(hostname)
fi

OVERLAYS_SOURCE=${OVERLAYS_SOURCE:-"$SOURCE/environment/overlays"}

WALLPAPERS_SOURCE=${WALLPAPERS_SOURCE:-"$SOURCE/wallpaper"}

if [ -z "$OVERLAY" ]; then
    if [ -f "$OVERLAYS_SOURCE/$HOST" ]; then
        OVERLAY=$(<"$OVERLAYS_SOURCE/$HOST")
    else
        OVERLAY=$(<"$OVERLAYS_SOURCE/current")
    fi
fi

move () {
    from="$1"
    to="$2"
    rm -rf "$to"
    cp -R "$from" "$to"
    chmod -R u+w "$to"
}

apply-overlay () {
    selection="$1"
    if [ ! -d "$selection" ]; then
        return 0
    fi
    find "$selection" -type f | while read -r file; do
        after=${file#"$selection/"}
        base=$(basename "$file")
        if [[ $base == "extension."* ]]; then
            newfile="$CONFIG_TARGET/${after%"$base"}${base#"extension."}"
            cat "$file" >> "$newfile"
        else
            newfile="$CONFIG_TARGET/$after"
            move "$file" "$newfile"
        fi
    done
}

copy () {
    if ! [ -d "$CONFIG_TARGET" ]; then
        mkdir -p "$CONFIG_TARGET"
    fi
    if ! [ -d "$SCRIPTS_TARGET" ]; then
        mkdir -p "$SCRIPTS_TARGET"
    fi

    move "$SCRIPTS_SOURCE" "$SCRIPTS_TARGET"
    chmod -R +x "$SCRIPTS_TARGET"

    find "$CONFIG_SOURCE" -maxdepth 1 -mindepth 1 -type d | while read -r config; do
        base=$(basename "$config")
        move "$config" "$CONFIG_TARGET/$base"
    done

    if [ -f "$CONFIG_TARGET/session/default-session" ]; then
        chmod +x "$CONFIG_TARGET/session/default-session"
    fi
    if [ -d "$CONFIG_TARGET/session/scripts" ]; then
        chmod -R +x "$CONFIG_TARGET/session/scripts"
    fi

    move "$CONFIG_SOURCE/zshrc" "$TARGET/.zshrc"
    move "$CONFIG_SOURCE/bashrc" "$TARGET/.bashrc"
    move "$CONFIG_SOURCE/user-dirs.dirs" "$CONFIG_TARGET/user-dirs.dirs"
    move "$CONFIG_SOURCE/starship.toml" "$CONFIG_TARGET/starship.toml"

    if [ -n "$HOST" ]; then
        apply-overlay "$HOSTS_SOURCE/$HOST"
    fi
    if [ -n "$OVERLAY" ]; then
        apply-overlay "$OVERLAYS_SOURCE/$OVERLAY"
    fi
}

switch () {
    vicinae_running=$(pgrep vicinae)
    noctalia_running=$(pgrep noctalia)

    if [ -n "$vicinae_running" ]; then
        pkill vicinae
    fi

    if [ -n "$noctalia_running" ]; then
        kill -STOP "$noctalia_running"
    fi

    copy

    if [ -n "$noctalia_running" ]; then
        kill -CONT "$noctalia_running"
    fi

    if [ -n "$vicinae_running" ]; then
        vicinae server &> /dev/null &
    fi

    set-theme
}

backcopy () {
    overlay=""
    config=""

    for arg in "$@"; do
        if [[ "$arg" == "--overlay" ]]; then
            overlay=1
        else
            config="$arg"
        fi
    done

    if [ -n "$overlay" ]; then
        to="$OVERLAYS_SOURCE/$OVERLAY/$config"
    else
        to="$CONFIG_SOURCE/$config"
    fi

    from="$CONFIG_TARGET/$config"
    move "$from" "$to"
}

set-theme () {
    mode="dark"

    while getopts ":w:m:c:" opt; do
        case "$opt" in
            w)
                wallpaper="$OPTARG"
                ;;
            m)
                mode="$OPTARG"
                if [ "$mode" != "dark" ] && [ "$mode" != "light" ]; then
                    echo "Invalid mode: $mode"
                    exit 1
                fi
                ;;
            c)
                colour="$OPTARG"
                ;;
            *)
                echo "Usage: $0 set-theme [-w <wallpaper>] [-m <mode>]"
                exit 1
                ;;
        esac
    done

    if [ -z "$wallpaper" ]; then
        wallpaper="$WALLPAPERS_SOURCE/$(<"$CONFIG_TARGET/theme/wallpaper")"
    fi

    if [ -z "$colour" ]; then
        colour=$(<"$CONFIG_TARGET/theme/colour")
    fi

    if command -v matugen &> /dev/null; then
        if [ -n "$colour" ]; then
            matugen color hex "$colour" -m "$mode"
        elif [ -f "$wallpaper" ]; then
            matugen image "$wallpaper" -t "scheme-tonal-spot" -m "$mode" --source-color-index 0
        fi
    fi
}

command="$1"
shift

case "$command" in
    copy)
        copy "$@"
        ;;
    switch)
        switch "$@"
        ;;
    backcopy)
        backcopy "$@"
        ;;
    set-theme)
        set-theme "$@"
        ;;
    *)
        echo "Unknown command: $command"
        exit 1
        ;;
esac

